# Copia este archivo como ".env" y rellena los valores.
# El archivo ".env" NUNCA se sube al repositorio.

# Puerto del servidor (Render lo define solo: no lo cambies alla)
PORT=3000

# ============================================================
# OPCION A - Tu PC (PostgreSQL local con pgAdmin)
# ============================================================
DB_USER=postgres
DB_HOST=localhost
DB_NAME=transmiflow_db
DB_PASSWORD=TU_CONTRASENA_AQUI
DB_PORT=5432

# ============================================================
# OPCION B - La nube (Neon)
# Solo necesitas esta linea. La copias desde el panel de Neon.
# Deja comentadas las de arriba para no mezclarlas.
# ============================================================
# DATABASE_URL=postgresql://usuario:contrasena@ep-xxx.region.neon.tech/transmiflow?sslmode=require
